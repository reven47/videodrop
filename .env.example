# Google AdSense
# Publisher ID (safe to expose, it is public).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7332953073473612
# Master switch. Keep "false" until AdSense approves the site and slot IDs exist.
NEXT_PUBLIC_ADS_ENABLED=false
# Ad unit slot IDs (numeric). Leave empty to show house creatives.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MID=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_REWARD=

# Rewarded video VAST tag for the download gate (optional).
NEXT_PUBLIC_REWARD_VAST_TAG=

# Public URL of the deployed site (used for sitemap, robots and canonical URLs).
NEXT_PUBLIC_SITE_URL=
